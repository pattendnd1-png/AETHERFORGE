+#!/usr/bin/env python3
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+def text(rel): return (ROOT/rel).read_text(encoding='utf-8')
+def need(ok,msg):
+    if not ok: raise SystemExit('FAIL: '+msg)
+
+cargo=text('Cargo.toml'); pkg=text('packaging/arch/PKGBUILD'); readme=text('README.md')
+main=text('crates/sto-gui/src/main.rs'); arc=text('crates/sto-gui/src/embedded_arc.rs')
+bridge=text('crates/sto-gui/src/arc_bridge.rs'); detect=text('crates/sto-detect/src/lib.rs')
+launch=text('crates/sto-launch/src/lib.rs'); install=text('crates/sto-install/src/lib.rs')
+need('version = "10.0.7"' in cargo,'workspace version')
+need('pkgver=10.0.7' in pkg,'PKGBUILD version')
+need(readme.startswith('# STO Linux Command 10.0.7'),'README version')
+need('## v10.0.7: Arc UI Context + Runtime Handshake Hotfix' in readme,'10.0.7 README section')
+need('matches_arc_ui_process' in bridge and 'arcosbrowser.exe' in bridge.lower(),'Arc browser host discriminator')
+for marker in ('--type=renderer','--type=gpu-process','--type=utility'):
+    need(marker in bridge,f'Arc helper rejection marker {marker}')
+need('matches_arc_ui_process(&cmdline)' in arc,'Arc containment accepts guarded browser host')
+need('!identity.contains("arcosbrowser")' not in arc,'no blanket ArcOSBrowser rejection')
+need('dispatcher may exit before the Arc client window appears' in arc,'dispatcher handoff grace')
+need('find_arc_dispatcher' in detect and 'arclauncher.exe' in detect.lower(),'Arc dispatcher detector')
+need('gamecustom' in launch.lower() and '"sto"' in launch.lower(),'STO Arc context launch args')
+open_arc=main.split('fn open_arc_for',1)[1].split('fn install_standalone',1)[0]
+need('find_arc_dispatcher(&snapshot.prefix)' in open_arc,'Arc open uses dispatcher')
+play=main.split('fn launch_sto',1)[1].split('fn open_arc_for',1)[0]
+need('arc_process_running' in play and 'ARC LAUNCHER' in play,'PLAY requires live Arc context')
+need('build_direct_sto_launch_plan' in play and 'wrap_direct_plan_in_gamescope' in play,'direct STO + Visual Stability retained')
+for marker in ('.arc-install.lock','create_new(true)','process_exists','remove_file'):
+    need(marker in install,f'cross-process installer lock marker {marker}')
+installer=text('scripts/install-v10007-dragon-glass.sh')
+for marker in ('TARGET_VERSION=10.0.7','MIGRATION_PREDECESSOR=10.0.6','pre-v10.0.7-',
+               'ARC_BROWSER_HOST_CONTAINMENT=guarded','ARC_STO_CONTEXT=gamecustom-sto',
+               'ARC_INSTALL_LOCK=cross-process','DIRECT_STO_REQUIRES_ARC_CONTEXT=enabled'):
+    need(marker in installer,f'installer marker {marker}')
+need('STO_LINUX_COMMAND_EXPECTED=10.0.7' in text('scripts/status-v10007.sh'),'status version')
+need('pre-v10.0.7-' in text('scripts/rollback-v10007.sh') and 'ROLLBACK_FROM=10.0.7' in text('scripts/rollback-v10007.sh'),'rollback version')
+print('PASS: 10.0.7 ARC_UI_CONTEXT + GUARDED_ARCOSBROWSER + INSTALL_LOCK + DIRECT_STO_HANDSHAKE')
