+fn acquire_installer_lock(lock_path: &Path) -> Result<()> {
+    if let Some(parent) = lock_path.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    for attempt in 0..2 {
+        match OpenOptions::new().write(true).create_new(true).open(lock_path) {
+            Ok(mut lock) => {
+                writeln!(lock, "{}", std::process::id())?;
+                return Ok(());
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists && attempt == 0 => {
+                let owner = fs::read_to_string(lock_path)
+                    .ok()
+                    .and_then(|value| value.trim().parse::<u32>().ok());
+                if owner.is_some_and(process_exists) {
+                    bail!("Arc installer is already running (PID {})", owner.unwrap());
+                }
+                fs::remove_file(lock_path)
+                    .with_context(|| format!("remove stale Arc installer lock {}", lock_path.display()))?;
+            }
+            Err(error) => {
+                return Err(error).with_context(|| format!("acquire Arc installer lock {}", lock_path.display()));
+            }
+        }
+    }
+    bail!("could not acquire Arc installer lock {}", lock_path.display())
+}
+
+fn process_exists(pid: u32) -> bool {
+    Path::new("/proc").join(pid.to_string()).exists()
+}
