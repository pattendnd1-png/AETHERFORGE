diff -ruN a/tests/test_v10007_arc_ui_context_hotfix.py b/tests/test_v10007_arc_ui_context_hotfix.py
--- a/tests/test_v10007_arc_ui_context_hotfix.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v10007_arc_ui_context_hotfix.py	2026-09-19 01:19:57.746403176 +0000
@@ -0,0 +1,56 @@
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+ARC = (ROOT/'crates/sto-gui/src/embedded_arc.rs').read_text()
+BRIDGE = (ROOT/'crates/sto-gui/src/arc_bridge.rs').read_text()
+MAIN = (ROOT/'crates/sto-gui/src/main.rs').read_text()
+LAUNCH = (ROOT/'crates/sto-launch/src/lib.rs').read_text()
+DETECT = (ROOT/'crates/sto-detect/src/lib.rs').read_text()
+INSTALL = (ROOT/'crates/sto-install/src/lib.rs').read_text()
+CARGO = (ROOT/'Cargo.toml').read_text()
+
+
+def test_arc_osbrowser_main_ui_is_supported_but_renderer_helpers_are_rejected():
+    assert 'matches_arc_ui_process' in BRIDGE
+    assert 'arcosbrowser.exe' in BRIDGE.lower()
+    assert '--type=renderer' in BRIDGE.lower()
+    assert 'matches_arc_ui_process(&cmdline)' in ARC
+    # 10.0.6 blanket-rejected the visible Arc Chromium host.
+    assert '!identity.contains("arcosbrowser")' not in ARC
+
+
+def test_arc_open_prefers_dispatcher_and_sto_context():
+    assert 'find_arc_dispatcher' in DETECT
+    assert 'arclauncher.exe' in DETECT.lower()
+    assert 'gamecustom' in LAUNCH.lower()
+    assert '"sto"' in LAUNCH.lower()
+    assert 'find_arc_dispatcher(&snapshot.prefix)' in MAIN
+
+
+def test_direct_play_requires_live_arc_context_before_sto_stub():
+    launch_start = MAIN.index('fn launch_sto')
+    launch_end = MAIN.index('fn open_arc_for', launch_start)
+    body = MAIN[launch_start:launch_end]
+    assert 'arc_process_running' in body
+    assert 'Open Arc' in body or 'ARC LAUNCHER' in body
+    assert 'build_direct_sto_launch_plan' in body
+
+
+def test_arc_installer_has_cross_process_lock():
+    assert '.arc-install.lock' in INSTALL
+    assert 'create_new(true)' in INSTALL
+    assert 'process_exists' in INSTALL
+    assert 'remove_file' in INSTALL
+
+
+def test_version_is_10_0_7():
+    assert 'version = "10.0.7"' in CARGO
+
+
+def test_arc_dispatcher_exit_does_not_abort_containment_handoff_immediately():
+    # ArcLauncher.exe is a dispatcher and can exit before Arc.exe/ArcOSBrowser
+    # exposes the visible UI. The controller must keep polling until timeout.
+    assert 'dispatcher may exit before the Arc client window appears' in ARC
+    host_dead = ARC.index('dispatcher may exit before the Arc client window appears')
+    timeout = ARC.index('ATTACH_TIMEOUT', host_dead)
+    assert host_dead < timeout
