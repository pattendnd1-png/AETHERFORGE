+++ b/tests/test_v10005_launch_handshake_hotfix.py	2026-09-19 00:28:06.920945231 +0000
@@ -0,0 +1,47 @@
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+def read(rel: str) -> str:
+    return (ROOT / rel).read_text(encoding='utf-8')
+
+
+def test_arc_running_requires_main_arc_process_not_browser_helper():
+    bridge = read('crates/sto-gui/src/arc_bridge.rs')
+    production = bridge.split('#[cfg(test)]', 1)[0]
+    assert 'matches_arc_main_process' in production
+    main_fn = production.split('pub fn matches_arc_main_process', 1)[1].split('pub fn', 1)[0]
+    assert 'arc.exe' in main_fn.lower()
+    assert 'arclauncher.exe' in main_fn.lower()
+    assert 'arcosbrowser.exe' not in main_fn.lower()
+
+
+def test_sto_detection_rejects_arc_stub_and_prefers_real_game_tree():
+    detect = read('crates/sto-detect/src/lib.rs')
+    assert 'sto_launcher_candidate_score' in detect
+    assert 'looks_like_sto_game_tree' in detect
+    assert 'find_sto_launcher_prefers_game_tree_over_arc_stub' in detect
+    assert 'Star Trek Online_en' in detect
+    assert 'Live' in detect
+
+
+def test_launch_task_waits_for_actual_sto_process_before_completion():
+    main = read('crates/sto-gui/src/main.rs')
+    assert 'Launch host started; waiting for Star Trek Online.exe or GameClient.exe' in main
+    assert 'complete_waiting(ActivityKind::Launch' in main
+    # Spawning Gamescope is not equivalent to a confirmed STO launch.
+    assert 'Embedded Star Trek Online started (Gamescope PID' not in main
+
+
+def test_launch_failure_surfaces_detected_launcher_and_log_path():
+    main = read('crates/sto-gui/src/main.rs')
+    assert 'Detected STO launcher:' in main
+    assert 'sto-launch.log' in main
+    assert 'Gamescope PID' in main
+
+
+def test_release_advances_to_10_0_5():
+    assert 'version = "10.0.5"' in read('Cargo.toml')
+    assert 'pkgver=10.0.5' in read('packaging/arch/PKGBUILD')
+    assert '10.0.5' in read('README.md')
+    assert (ROOT / 'scripts/verify-v10005-release.py').is_file()
