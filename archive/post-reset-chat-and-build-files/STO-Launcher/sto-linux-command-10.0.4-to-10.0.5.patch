+' || printf 'UMU=missing
+'
+command -v gamescope >/dev/null 2>&1 && printf 'GAMESCOPE=present
+' || printf 'GAMESCOPE=missing
+'
+command -v xdotool >/dev/null 2>&1 && printf 'XDOTOOL=present
+' || printf 'XDOTOOL=missing
+'
+[[ -n "${DISPLAY:-}" ]] && printf 'DISPLAY=%s
