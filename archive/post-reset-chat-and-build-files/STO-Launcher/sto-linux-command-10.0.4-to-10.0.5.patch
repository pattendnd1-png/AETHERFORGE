diff -ruN a/scripts/install-v10005-dragon-glass.sh b/scripts/install-v10005-dragon-glass.sh
--- a/scripts/install-v10005-dragon-glass.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/install-v10005-dragon-glass.sh	2026-09-19 00:32:29.730244762 +0000
@@ -0,0 +1,140 @@
+#!/usr/bin/env bash
+set -euo pipefail
+root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+mode="${1:---all}"
+MIGRATION_PREDECESSOR=10.0.4
+TARGET_VERSION=10.0.5
+AETHERFORGE_OS_VERSION=10.0.3
+
+say(){ printf '==> %s\n' "$*"; }
+fail(){ printf 'ERROR: %s\n' "$*" >&2; exit 1; }
+
+version_gt(){
+  local left="$1" right="$2" highest
+  [[ "$left" == "$right" ]] && return 1
+  highest="$(printf '%s\n%s\n' "$left" "$right" | sort -V | tail -n1)"
+  [[ "$highest" == "$left" ]]
+}
+
+source_gate(){
+  cd "$root"
+  say "10.0.5 Arc/STO launch handshake hotfix source invariants"
+  PYTHONDONTWRITEBYTECODE=1 python scripts/verify-v10005-release.py
+  say "10.0.4 Embedded STO + Visual Stability inheritance"
+  PYTHONDONTWRITEBYTECODE=1 python scripts/verify-v10004-release.py
+  say "10.0.3 AetherForge synchronization inheritance"
+  PYTHONDONTWRITEBYTECODE=1 python scripts/verify-v10003-release.py
+  say "v1.19 Arc account/security inheritance"
+  PYTHONDONTWRITEBYTECODE=1 python scripts/verify-v1190-release.py
+  say "Python regression suite (stdlib runner; pytest not required)"
+  PYTHONDONTWRITEBYTECODE=1 python scripts/run-python-regressions.py
+}
+
+rust_gate(){
+  command -v cargo >/dev/null 2>&1 || fail "cargo is required for the Rust qualification gate"
+  cd "$root"
+  say "cargo fmt --all (normalize disposable extracted source)"
+  cargo fmt --all
+  say "cargo fmt --all --check"
+  cargo fmt --all --check
+  say "cargo clippy --workspace --all-targets --all-features -- -D warnings"
+  cargo clippy --workspace --all-targets --all-features -- -D warnings
+  say "cargo test --workspace"
+  cargo test --workspace
+  say "cargo build --release --workspace"
+  cargo build --release --workspace
+}
+
+runtime_gate(){
+  command -v gamescope >/dev/null 2>&1 || fail "gamescope is required for contained STO: sudo pacman -S --needed gamescope"
+  command -v xdotool >/dev/null 2>&1 || fail "xdotool is required for X11/XWayland containment: sudo pacman -S --needed xdotool"
+  if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
+    command -v Xwayland >/dev/null 2>&1 || fail "XWayland is required for contained STO on Wayland: sudo pacman -S --needed xorg-xwayland"
+  fi
+}
+
+installed_version(){
+  local state_file="$1"
+  [[ -f "$state_file" ]] || return 0
+  awk -F= '$1=="STO_LINUX_COMMAND_VERSION" {print $2; exit}' "$state_file"
+}
+
+migration_gate(){
+  local state_file="$1"
+  PREVIOUS_VERSION="$(installed_version "$state_file")"
+  if [[ "$PREVIOUS_VERSION" == "$MIGRATION_PREDECESSOR" ]]; then
+    say "Canonical hotfix migration: 10.0.4 -> 10.0.5"
+  elif [[ -n "$PREVIOUS_VERSION" && "$PREVIOUS_VERSION" != "$TARGET_VERSION" ]]; then
+    if version_gt "$PREVIOUS_VERSION" "$TARGET_VERSION"; then
+      fail "refusing downgrade from installed STO Linux Command $PREVIOUS_VERSION to $TARGET_VERSION"
+    fi
+    say "Migrating prior STO Linux Command $PREVIOUS_VERSION -> $TARGET_VERSION"
+  fi
+}
+
+install_gate(){
+  cd "$root"
+  runtime_gate
+  prefix="${PREFIX:-$HOME/.local}"
+  state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sto-linux-command"
+  state_file="$state_dir/release-state"
+  mkdir -p "$state_dir"
+  PREVIOUS_VERSION=""
+  migration_gate "$state_file"
+  previous_version="$PREVIOUS_VERSION"
+  stamp="$(date +%Y%m%d-%H%M%S)"
+  backup_dir="$state_dir/backups/pre-v10.0.5-$stamp"
+  mkdir -p "$backup_dir"
+
+  backed_up=0
+  for rel in bin/sto-linux bin/sto-linux-gui share/applications/sto-linux-command.desktop; do
+    if [[ -e "$prefix/$rel" ]]; then
+      mkdir -p "$backup_dir/$(dirname "$rel")"
+      cp -a "$prefix/$rel" "$backup_dir/$rel"
+      backed_up=1
+    fi
+  done
+  if [[ "$backed_up" -eq 1 ]]; then say "Existing launcher backed up to $backup_dir"; fi
+
+  say "Installing STO Linux Command 10.0.5 Arc/STO Launch Handshake Hotfix"
+  if ! bash scripts/install-local.sh; then
+    say "Install failed; restoring previous launcher files"
+    for rel in bin/sto-linux bin/sto-linux-gui share/applications/sto-linux-command.desktop; do
+      if [[ -e "$backup_dir/$rel" ]]; then
+        mkdir -p "$prefix/$(dirname "$rel")"
+        cp -a "$backup_dir/$rel" "$prefix/$rel"
+      fi
+    done
+    fail "10.0.5 install failed and prior launcher files were restored when available"
+  fi
+
+  migrated_from="${previous_version:-none}"
+  cat > "$state_file" <<EOF
+STO_LINUX_COMMAND_VERSION=10.0.5
+AETHERFORGE_OS_VERSION=10.0.3
+MIGRATION_PREDECESSOR=10.0.4
+MIGRATED_FROM=$migrated_from
+DRAGON_GLASS_UIUX=qualified-host-install
+ARC_FIRST_CLASS=enabled
+ARC_ACCOUNT_HYBRID=enabled
+ARC_AUTHORITY=official-client
+DIRECT_STO=enabled
+EMBEDDED_STO=enabled
+VISUAL_STABILITY=enabled
+NO_DETACHED_FALLBACK=enforced
+LOCAL_ARC_INSTALLER_IMPORT=enabled
+ARC_MAIN_PROCESS_GUARD=enabled
+STO_GAME_TREE_DETECTION=enabled
+LAUNCH_CONFIRMATION=gameclient-observed
+GAMESCOPE_CONTAINMENT=required
+X11_XWAYLAND_CONTAINMENT=required
+EOF
+  say "Installed release state: $state_file"
+}
+
+case "$mode" in
+  --self-test) source_gate ;;
+  --build-test) source_gate; rust_gate ;;
+  --install|--all) source_gate; rust_gate; install_gate ;;
+  *) fail "usage: $0 [--self-test|--build-test|--install|--all]" ;;
+esac
diff -ruN a/scripts/rollback-v10005.sh b/scripts/rollback-v10005.sh
--- a/scripts/rollback-v10005.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/rollback-v10005.sh	2026-09-19 00:32:29.730383822 +0000
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -euo pipefail
+prefix="${PREFIX:-$HOME/.local}"
+state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sto-linux-command"
+state_file="$state_dir/release-state"
+backup_root="$state_dir/backups"
+fail(){ printf 'ERROR: %s
+' "$*" >&2; exit 1; }
+latest="$(find "$backup_root" -maxdepth 1 -type d -name 'pre-v10.0.5-*' -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)"
+[[ -n "$latest" && -d "$latest" ]] || fail "no pre-v10.0.5 backup found under $backup_root"
+restored=0
+for rel in bin/sto-linux bin/sto-linux-gui share/applications/sto-linux-command.desktop; do
+  if [[ -e "$latest/$rel" ]]; then
+    mkdir -p "$prefix/$(dirname "$rel")"
+    cp -a "$latest/$rel" "$prefix/$rel"
+    restored=1
+  fi
+done
+[[ "$restored" -eq 1 ]] || fail "backup contains no restorable launcher files"
+previous="10.0.4"
+if [[ -f "$state_file" ]]; then
+  candidate="$(awk -F= '$1=="MIGRATED_FROM" {print $2; exit}' "$state_file")"
+  [[ -n "$candidate" && "$candidate" != "none" ]] && previous="$candidate"
+fi
+cat > "$state_file" <<EOF
+STO_LINUX_COMMAND_VERSION=$previous
+AETHERFORGE_OS_VERSION=10.0.3
+ROLLBACK_FROM=10.0.5
+ROLLBACK_SOURCE=$latest
+ROLLBACK_RESULT=PASS
+EOF
+printf 'ROLLBACK_RESULT=PASS
+'
+printf 'ROLLBACK_SOURCE=%s
+' "$latest"
+printf 'RESTORED_VERSION=%s
+' "$previous"
