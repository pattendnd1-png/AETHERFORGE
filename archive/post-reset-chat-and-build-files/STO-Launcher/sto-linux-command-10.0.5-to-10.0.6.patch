diff -ruN a/tests/test_v10006_arc_containment_correction.py b/tests/test_v10006_arc_containment_correction.py
--- a/tests/test_v10006_arc_containment_correction.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v10006_arc_containment_correction.py	2026-09-19 00:48:36.968719091 +0000
@@ -0,0 +1,47 @@
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+
+def read(p): return (ROOT/p).read_text()
+
+def test_arc_not_sto_is_embedded_surface():
+    main=read('crates/sto-gui/src/main.rs')
+    assert 'mod embedded_arc;' in main
+    assert 'EmbeddedArcController' in main
+    assert 'show_embedded_arc' in main
+    launch=main.split('fn launch_sto(&mut self)',1)[1].split('fn open_arc_for',1)[0]
+    assert 'embedded_game::detect_prerequisites' not in launch
+    assert 'begin_pending' not in launch
+    assert 'wrap_direct_plan_in_gamescope' in launch
+
+def test_arc_open_requests_containment():
+    main=read('crates/sto-gui/src/main.rs')
+    arc=main.split('fn open_arc_for',1)[1].split('fn install_standalone',1)[0]
+    assert 'embedded_arc::detect_prerequisites' in arc
+    assert 'arc_embed_requested: true' in arc
+    assert 'arc_host_pid: Some(pid)' in arc
+
+def test_wayland_session_reexecs_launcher_onto_xwayland():
+    src=read('crates/sto-gui/src/embedded_arc.rs')
+    for marker in ('WAYLAND_DISPLAY','WAYLAND_SOCKET','DISPLAY','env_remove','CommandExt','AETHERFORGE_STO_X11_HOST'):
+        assert marker in src
+
+def test_arc_window_selection_uses_main_arc_process_not_helper():
+    src=read('crates/sto-gui/src/embedded_arc.rs')
+    assert 'matches_arc_main_process' in src
+    assert 'getwindowpid' in src
+    assert 'windowreparent' in src
+    assert 'getwindowclassname' in src
+    assert 'looks_like_arc_window_identity' in src
+    assert 'ArcOSBrowser' not in src
+
+def test_direct_play_does_not_use_containment_controller():
+    main=read('crates/sto-gui/src/main.rs')
+    launch=main.split('fn launch_sto(&mut self)',1)[1].split('fn open_arc_for',1)[0]
+    assert 'embedded_arc' not in launch
+    assert 'embedded_pid' not in launch
+    assert 'embedded_refresh_hz' not in launch
+
+def test_release_is_10006():
+    assert 'version = "10.0.6"' in read('Cargo.toml')
+    assert 'pkgver=10.0.6' in read('packaging/arch/PKGBUILD')
+    assert read('README.md').startswith('# STO Linux Command 10.0.6')
