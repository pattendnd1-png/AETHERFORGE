@@ -0,0 +1,422 @@
+use anyhow::{bail, Context, Result};
+use serde::{Deserialize, Serialize};
+use sto_core::{AppPaths, LaunchPlan};
+use std::{
+    collections::BTreeMap,
+    fs,
+    path::{Path, PathBuf},
+    process::Command,
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default)]
+#[serde(rename_all = "snake_case")]
+pub enum VisualProfile {
+    #[default]
+    VisualStability,
+    LowLatency,
+    Compatibility,
+}
+
+impl VisualProfile {
+    pub const ALL: [Self; 3] = [Self::VisualStability, Self::LowLatency, Self::Compatibility];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::VisualStability => "Visual Stability",
+            Self::LowLatency => "Low Latency",
+            Self::Compatibility => "Compatibility",
+        }
+    }
+
+    pub fn adaptive_sync(self) -> bool {
+        matches!(self, Self::VisualStability | Self::LowLatency)
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DisplayMode {
+    pub width: u32,
+    pub height: u32,
+    pub refresh_hz: u32,
+    pub source: String,
+}
+
+impl Default for DisplayMode {
+    fn default() -> Self {
+        Self { width: 1920, height: 1080, refresh_hz: 60, source: "fallback".into() }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct VisualLaunchPreparation {
+    pub display: DisplayMode,
+    pub target_refresh_hz: u32,
+    pub dxvk_config: PathBuf,
+    pub gameprefs: Option<PathBuf>,
+    pub gameprefs_backup: Option<PathBuf>,
+    pub notes: Vec<String>,
+}
+
+pub fn target_refresh_hz(profile: VisualProfile, refresh_hz: u32) -> u32 {
+    let refresh_hz = refresh_hz.max(30);
+    match profile {
+        VisualProfile::VisualStability if refresh_hz > 60 => refresh_hz.saturating_sub(3).max(60),
+        VisualProfile::LowLatency if refresh_hz > 60 => refresh_hz.saturating_sub(1).max(60),
+        _ => refresh_hz,
+    }
+}
+
+pub fn detect_display_mode() -> DisplayMode {
+    probe_kscreen_doctor()
+        .or_else(probe_wlr_randr)
+        .or_else(probe_xrandr)
+        .unwrap_or_default()
+}
+
+fn command_output(program: &str, args: &[&str]) -> Option<String> {
+    let output = Command::new(program).args(args).output().ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    Some(String::from_utf8_lossy(&output.stdout).into_owned())
+}
+
+fn probe_kscreen_doctor() -> Option<DisplayMode> {
+    let text = command_output("kscreen-doctor", &["-o"])?;
+    for token in text.split_whitespace() {
+        if token.contains('x') && token.contains('@') && token.contains('*') {
+            if let Some((width, height, refresh_hz)) = parse_mode_token(token) {
+                return Some(DisplayMode { width, height, refresh_hz, source: "kscreen-doctor".into() });
+            }
+        }
+    }
+    // Some kscreen-doctor versions omit the asterisk but still print a single active mode.
+    for token in text.split_whitespace() {
+        if token.contains('x') && token.contains('@') {
+            if let Some((width, height, refresh_hz)) = parse_mode_token(token) {
+                return Some(DisplayMode { width, height, refresh_hz, source: "kscreen-doctor".into() });
+            }
+        }
+    }
+    None
+}
+
+fn probe_wlr_randr() -> Option<DisplayMode> {
+    let text = command_output("wlr-randr", &[])?;
+    for line in text.lines().filter(|line| line.contains("current")) {
+        let mut width = None;
+        let mut height = None;
+        let mut refresh = None;
+        let parts: Vec<_> = line.split_whitespace().collect();
+        for (index, token) in parts.iter().enumerate() {
+            if width.is_none() {
+                if let Some((w, h)) = parse_resolution(token) {
+                    width = Some(w);
+                    height = Some(h);
+                }
+            }
+            if token.eq_ignore_ascii_case("Hz") && index > 0 {
+                refresh = parse_refresh(parts[index - 1]);
+            }
+        }
+        if let (Some(width), Some(height), Some(refresh_hz)) = (width, height, refresh) {
+            return Some(DisplayMode { width, height, refresh_hz, source: "wlr-randr".into() });
+        }
+    }
+    None
+}
+
+fn probe_xrandr() -> Option<DisplayMode> {
+    let text = command_output("xrandr", &["--current"])?;
+    for line in text.lines() {
+        if !line.contains('*') {
+            continue;
+        }
+        let parts: Vec<_> = line.split_whitespace().collect();
+        let (width, height) = parts.first().and_then(|value| parse_resolution(value))?;
+        let refresh_hz = parts.iter().find_map(|token| {
+            if token.contains('*') { parse_refresh(token) } else { None }
+        })?;
+        return Some(DisplayMode { width, height, refresh_hz, source: "xrandr".into() });
+    }
+    None
+}
+
+fn parse_mode_token(token: &str) -> Option<(u32, u32, u32)> {
+    let clean = token
+        .trim_matches(|c: char| !c.is_ascii_digit() && c != 'x' && c != '@' && c != '.' && c != ':')
+        .rsplit(':')
+        .next()?;
+    let (resolution, refresh) = clean.split_once('@')?;
+    let (width, height) = parse_resolution(resolution)?;
+    let refresh_hz = parse_refresh(refresh)?;
+    Some((width, height, refresh_hz))
+}
+
+fn parse_resolution(token: &str) -> Option<(u32, u32)> {
+    let clean = token.trim_matches(|c: char| !c.is_ascii_digit() && c != 'x');
+    let (width, height) = clean.split_once('x')?;
+    Some((width.parse().ok()?, height.parse().ok()?))
+}
+
+fn parse_refresh(token: &str) -> Option<u32> {
+    let clean = token.trim_matches(|c: char| !c.is_ascii_digit() && c != '.');
+    let value: f32 = clean.parse().ok()?;
+    if !value.is_finite() || value < 1.0 {
+        return None;
+    }
+    Some(value.round() as u32)
+}
+
+pub fn prepare_visual_launch(paths: &AppPaths, sto_executable: &Path, profile: VisualProfile) -> Result<VisualLaunchPreparation> {
+    let display = detect_display_mode();
+    let target_refresh_hz = target_refresh_hz(profile, display.refresh_hz);
+    let dxvk_config = paths.config_dir.join("visual").join("dxvk-sto.conf");
+    write_dxvk_config(&dxvk_config, profile, target_refresh_hz)?;
+
+    let mut notes = vec![format!(
+        "Display: {}x{} @ {} Hz via {}; target {} Hz",
+        display.width, display.height, display.refresh_hz, display.source, target_refresh_hz
+    )];
+    let gameprefs = find_gameprefs(sto_executable);
+    let gameprefs_backup = match gameprefs.as_deref() {
+        Some(path) => match patch_gameprefs(path, &display) {
+            Ok(backup) => {
+                notes.push(format!("GamePrefs applied: {}", path.display()));
+                Some(backup)
+            }
+            Err(error) => {
+                notes.push(format!("GamePrefs not changed: {error:#}"));
+                None
+            }
+        },
+        None => {
+            notes.push("GamePrefs.Pref not found yet; runtime visual profile will still be applied".into());
+            None
+        }
+    };
+
+    Ok(VisualLaunchPreparation {
+        display,
+        target_refresh_hz,
+        dxvk_config,
+        gameprefs,
+        gameprefs_backup,
+        notes,
+    })
+}
+
+pub fn dxvk_config_text(profile: VisualProfile, target_refresh_hz: u32) -> String {
+    match profile {
+        VisualProfile::VisualStability => format!(
+            "# STO Linux Command Visual Stability\n\
+             dxvk.tearFree = True\n\
+             dxgi.maxFrameLatency = 1\n\
+             dxgi.syncInterval = 1\n\
+             dxgi.maxFrameRate = {target_refresh_hz}\n"
+        ),
+        VisualProfile::LowLatency => format!(
+            "# STO Linux Command Low Latency\n\
+             dxvk.tearFree = Auto\n\
+             dxgi.maxFrameLatency = 1\n\
+             dxgi.syncInterval = 0\n\
+             dxgi.maxFrameRate = {target_refresh_hz}\n"
+        ),
+        VisualProfile::Compatibility => format!(
+            "# STO Linux Command Compatibility\n\
+             dxvk.tearFree = True\n\
+             dxgi.maxFrameLatency = 2\n\
+             dxgi.syncInterval = 1\n\
+             dxgi.maxFrameRate = {target_refresh_hz}\n"
+        ),
+    }
+}
+
+pub fn write_dxvk_config(path: &Path, profile: VisualProfile, target_refresh_hz: u32) -> Result<()> {
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).with_context(|| format!("create {}", parent.display()))?;
+    }
+    fs::write(path, dxvk_config_text(profile, target_refresh_hz))
+        .with_context(|| format!("write {}", path.display()))
+}
+
+pub fn find_gameprefs(sto_executable: &Path) -> Option<PathBuf> {
+    let parent = sto_executable.parent()?;
+    let candidates = [
+        parent.join("Star Trek Online").join("Live").join("localdata").join("GamePrefs.Pref"),
+        parent.join("Live").join("localdata").join("GamePrefs.Pref"),
+        parent.join("localdata").join("GamePrefs.Pref"),
+    ];
+    candidates.into_iter().find(|path| path.is_file())
+}
+
+pub fn backup_gameprefs(path: &Path) -> Result<PathBuf> {
+    if !path.is_file() {
+        bail!("GamePrefs file does not exist: {}", path.display());
+    }
+    let stamp = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_secs();
+    let backup_dir = path.parent().context("GamePrefs has no parent directory")?.join("sto-linux-backups");
+    fs::create_dir_all(&backup_dir)?;
+    let backup = backup_dir.join(format!("GamePrefs.Pref.{stamp}.bak"));
+    fs::copy(path, &backup).with_context(|| format!("backup {} to {}", path.display(), backup.display()))?;
+    Ok(backup)
+}
+
+pub fn patch_gameprefs(path: &Path, display: &DisplayMode) -> Result<PathBuf> {
+    let original = fs::read_to_string(path).with_context(|| format!("read {}", path.display()))?;
+    let backup = backup_gameprefs(path)?;
+    let edits = BTreeMap::from([
+        ("GfxSettings.Fullscreen", "0".to_string()),
+        ("GfxSettings.ScreenWidth", display.width.to_string()),
+        ("GfxSettings.ScreenHeight", display.height.to_string()),
+    ]);
+    let mut seen = BTreeMap::new();
+    let mut output = Vec::new();
+
+    for line in original.lines() {
+        let trimmed = line.trim_start();
+        let parts: Vec<_> = trimmed.split_whitespace().collect();
+        if parts.len() >= 3 && parts[0].eq_ignore_ascii_case("PrefEntry") {
+            if let Some(value) = edits.get(parts[1]) {
+                output.push(format!("PrefEntry {} {}", parts[1], value));
+                seen.insert(parts[1].to_string(), true);
+                continue;
+            }
+        }
+        output.push(line.to_string());
+    }
+
+    for (key, value) in edits {
+        if !seen.contains_key(key) {
+            output.push(format!("PrefEntry {key} {value}"));
+        }
+    }
+
+    let temp = path.with_extension("Pref.tmp");
+    fs::write(&temp, format!("{}\n", output.join("\n")))
+        .with_context(|| format!("write {}", temp.display()))?;
+    fs::rename(&temp, path).with_context(|| format!("replace {}", path.display()))?;
+    Ok(backup)
+}
+
+pub fn restore_latest_gameprefs_backup(sto_executable: &Path) -> Result<PathBuf> {
+    let gameprefs = find_gameprefs(sto_executable).context("GamePrefs.Pref is not present")?;
+    let backup_dir = gameprefs.parent().context("GamePrefs has no parent directory")?.join("sto-linux-backups");
+    let mut backups = fs::read_dir(&backup_dir)
+        .with_context(|| format!("read {}", backup_dir.display()))?
+        .filter_map(|entry| entry.ok())
+        .map(|entry| entry.path())
+        .filter(|path| path.file_name().and_then(|name| name.to_str()).is_some_and(|name| name.starts_with("GamePrefs.Pref.") && name.ends_with(".bak")))
+        .collect::<Vec<_>>();
+    backups.sort();
+    let latest = backups.pop().context("no STO Linux Command GamePrefs backup exists")?;
+    fs::copy(&latest, &gameprefs)
+        .with_context(|| format!("restore {} from {}", gameprefs.display(), latest.display()))?;
+    Ok(latest)
+}
+
+pub fn wrap_direct_plan_in_gamescope(
+    direct: &LaunchPlan,
+    gamescope: &Path,
+    prep: &VisualLaunchPreparation,
+    profile: VisualProfile,
+) -> Result<LaunchPlan> {
+    if direct.env.get("GAMEID").map(String::as_str) != Some("umu-default")
+        || direct.env.get("STORE").map(String::as_str) != Some("none")
+        || direct.env.get("PROTONPATH").map(String::as_str) != Some("GE-Proton")
+        || direct.env.get("PROTON_VERB").map(String::as_str) != Some("runinprefix")
+    {
+        bail!("refusing to wrap a non-canonical direct STO plan");
+    }
+
+    let mut args = vec![
+        "--backend".into(), "sdl".into(),
+        "-b".into(),
+        "--force-windows-fullscreen".into(),
+        "-w".into(), prep.display.width.to_string(),
+        "-h".into(), prep.display.height.to_string(),
+        "-W".into(), prep.display.width.to_string(),
+        "-H".into(), prep.display.height.to_string(),
+        "-r".into(), prep.target_refresh_hz.to_string(),
+    ];
+    if profile.adaptive_sync() {
+        args.push("--adaptive-sync".into());
+    }
+    args.push("--".into());
+    args.push(direct.program.display().to_string());
+    args.extend(direct.args.iter().cloned());
+
+    let mut env = direct.env.clone();
+    env.insert("DXVK_CONFIG_FILE".into(), prep.dxvk_config.display().to_string());
+    // Force the outer nested Gamescope window onto X11/XWayland so it can be
+    // reparented into the native launcher. The game remains inside Gamescope.
+    env.insert("SDL_VIDEODRIVER".into(), "x11".into());
+
+    Ok(LaunchPlan {
+        program: gamescope.to_path_buf(),
+        args,
+        working_dir: direct.working_dir.clone(),
+        env,
+        description: format!("Embedded STO via Gamescope ({})", profile.label()),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use sto_core::LaunchPlan;
+    use tempfile::TempDir;
+
+    #[test]
+    fn profile_targets_stay_at_or_below_refresh() {
+        assert_eq!(target_refresh_hz(VisualProfile::VisualStability, 144), 141);
+        assert_eq!(target_refresh_hz(VisualProfile::LowLatency, 144), 143);
+        assert_eq!(target_refresh_hz(VisualProfile::Compatibility, 144), 144);
+        assert_eq!(target_refresh_hz(VisualProfile::VisualStability, 60), 60);
+    }
+
+    #[test]
+    fn gameprefs_preserves_unknown_lines_and_patches_verified_keys() {
+        let temp = TempDir::new().unwrap();
+        let path = temp.path().join("GamePrefs.Pref");
+        fs::write(&path, "# keep me\nPrefEntry Unknown.Setting 99\nPrefEntry GfxSettings.Fullscreen 1\n").unwrap();
+        let backup = patch_gameprefs(&path, &DisplayMode { width: 2560, height: 1440, refresh_hz: 144, source: "test".into() }).unwrap();
+        assert!(backup.is_file());
+        let text = fs::read_to_string(path).unwrap();
+        assert!(text.contains("# keep me"));
+        assert!(text.contains("PrefEntry Unknown.Setting 99"));
+        assert!(text.contains("PrefEntry GfxSettings.Fullscreen 0"));
+        assert!(text.contains("PrefEntry GfxSettings.ScreenWidth 2560"));
+        assert!(text.contains("PrefEntry GfxSettings.ScreenHeight 1440"));
+    }
+
+    #[test]
+    fn gamescope_wrapper_keeps_umu_contract() {
+        let direct = LaunchPlan {
+            program: PathBuf::from("/usr/bin/umu-run"),
+            args: vec!["/prefix/Star Trek Online.exe".into()],
+            working_dir: PathBuf::from("/prefix"),
+            env: BTreeMap::from([
+                ("GAMEID".into(), "umu-default".into()),
+                ("STORE".into(), "none".into()),
+                ("PROTONPATH".into(), "GE-Proton".into()),
+                ("PROTON_VERB".into(), "runinprefix".into()),
+            ]),
+            description: "direct".into(),
+        };
+        let prep = VisualLaunchPreparation {
+            display: DisplayMode { width: 1920, height: 1080, refresh_hz: 144, source: "test".into() },
+            target_refresh_hz: 141,
+            dxvk_config: PathBuf::from("/tmp/dxvk.conf"),
+            gameprefs: None,
+            gameprefs_backup: None,
+            notes: Vec::new(),
+        };
+        let wrapped = wrap_direct_plan_in_gamescope(&direct, Path::new("gamescope"), &prep, VisualProfile::VisualStability).unwrap();
+        assert_eq!(wrapped.program, PathBuf::from("gamescope"));
+        assert!(wrapped.args.iter().any(|arg| arg == "/usr/bin/umu-run"));
+        assert_eq!(wrapped.env.get("PROTON_VERB").map(String::as_str), Some("runinprefix"));
+        assert!(!wrapped.args.iter().any(|arg| arg == "--immediate-flips"));
+    }
+}
