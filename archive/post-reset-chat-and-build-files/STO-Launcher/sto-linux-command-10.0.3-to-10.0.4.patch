diff -ruN a/scripts/verify-v10004-release.py b/scripts/verify-v10004-release.py
--- a/scripts/verify-v10004-release.py	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/verify-v10004-release.py	2026-09-19 00:09:35.478817868 +0000
@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import re
+import sys
+import tomllib
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def text(rel: str) -> str:
+    path = ROOT / rel
+    return path.read_text(encoding='utf-8') if path.exists() else ''
+
+
+def need(ok: bool, message: str) -> None:
+    if not ok:
+        print(f'FAIL: {message}', file=sys.stderr)
+        raise SystemExit(1)
+
+cargo = text('Cargo.toml')
+pkg = text('packaging/arch/PKGBUILD')
+readme = text('README.md')
+main = text('crates/sto-gui/src/main.rs')
+embed = text('crates/sto-gui/src/embedded_game.rs')
+visual = text('crates/sto-launch/src/visual.rs')
+launch = text('crates/sto-launch/src/lib.rs')
+install = text('crates/sto-install/src/lib.rs')
+settings = text('crates/sto-gui/src/pages/settings.rs')
+prefs = text('crates/sto-gui/src/preferences.rs')
+installer = text('scripts/install-v10004-dragon-glass.sh')
+status = text('scripts/status-v10004.sh')
+rollback = text('scripts/rollback-v10004.sh')
+
+need('version = "10.0.4"' in cargo, 'workspace version is not 10.0.4')
+need(readme.startswith('# STO Linux Command 10.0.4'), 'README version is not 10.0.4')
+need('pkgver=10.0.4' in pkg, 'PKGBUILD version is not 10.0.4')
+need('## v10.0.4: Embedded STO + Visual Stability' in readme, '10.0.4 README section missing')
+need('10.0.3' in readme, '10.0.3 predecessor lineage missing')
+
+for dep in ("'gamescope'", "'xdotool'", "'xorg-xwayland'"):
+    need(dep in pkg, f'Arch runtime dependency missing: {dep}')
+
+# EMBEDDED_STO
+for marker in ('EmbeddedGameController', 'windowreparent', 'windowmove', 'windowsize', 'DISPLAY', 'AetherForge STO Launcher'):
+    need(marker in embed, f'embedded containment marker missing: {marker}')
+need('detect_prerequisites()' in main, 'PLAY does not enforce embedded prerequisites')
+need('begin_pending(pid)' in main, 'Gamescope PID is not handed to containment controller')
+need('show_embedded_game' in main, 'embedded viewport UI missing')
+need('Full View' in main and 'Release Mouse' in main and 'Exit Game' in main, 'embedded viewport controls incomplete')
+
+# NO_DETACHED_FALLBACK
+need('detached fallback is intentionally disabled' in embed, 'no-detached fallback contract missing')
+need('process_group(0)' in launch, 'launch process group isolation missing')
+need('Command::new("kill")' in embed, 'containment termination command missing')
+need('"-TERM", "--", &process_group' in embed, 'containment failure does not terminate launch process group')
+
+# VISUAL_STABILITY
+for marker in ('pub enum VisualProfile', 'VisualStability', 'LowLatency', 'Compatibility', 'prepare_visual_launch', 'wrap_direct_plan_in_gamescope'):
+    need(marker in visual, f'visual stability marker missing: {marker}')
+production_visual = visual.split('#[cfg(test)]', 1)[0]
+need('args.push("--immediate-flips"' not in production_visual and '"--immediate-flips".into()' not in production_visual, 'Gamescope immediate flips must not be enabled')
+need('dxvk.tearFree = True' in visual and 'dxgi.maxFrameLatency = 1' in visual and 'dxgi.syncInterval' in visual, 'DXVK stability policy missing')
+for key in ('GfxSettings.Fullscreen', 'GfxSettings.ScreenWidth', 'GfxSettings.ScreenHeight'):
+    need(key in visual, f'verified GamePrefs key missing: {key}')
+for key in ('GfxSettings.VSync', 'GfxSettings.RefreshRate', 'GfxSettings.Antialiasing'):
+    need(key not in production_visual, f'unverified GamePrefs key must not be written: {key}')
+need('backup_gameprefs' in visual and 'restore_latest_gameprefs_backup' in visual, 'GamePrefs backup/restore missing')
+need('Restore Previous GamePrefs' in settings, 'GamePrefs restore UI missing')
+need('visual_profile' in prefs and 'VisualProfile::VisualStability' in prefs, 'visual profile persistence/default missing')
+
+# Direct STO stays direct and Arc-independent.
+launch_start = main.find('fn launch_sto')
+launch_end = main.find('fn open_arc_for', launch_start)
+need(launch_start >= 0 and launch_end > launch_start, 'launch_sto function missing')
+launch_body = main[launch_start:launch_end]
+need('build_direct_sto_launch_plan' in launch_body, 'direct STO builder missing from PLAY')
+need('build_arc_launch_plan' not in launch_body and 'open_arc' not in launch_body.lower(), 'PLAY routes through Arc')
+for marker in ('GAMEID', 'umu-default', 'STORE', 'none', 'PROTONPATH', 'GE-Proton', 'PROTON_VERB', 'runinprefix', 'Star Trek Online.exe'):
+    need(marker in launch, f'frozen direct runtime marker missing: {marker}')
+need('windows_target_argument' in launch and 'gamescope' in launch, 'wrapped-plan validator missing')
+
+# ARC_INSTALLER_NOT_BUNDLED
+need('import_local_installer' in install and 'validate_windows_executable' in install and 'b"MZ"' in install, 'local Arc installer import validation missing')
+need('ArcInstall-local.source.txt' in install and 'sha256_file' in install, 'local Arc installer evidence logging missing')
+for path in ROOT.rglob('*'):
+    if not path.is_file():
+        continue
+    rel = path.relative_to(ROOT)
+    need(path.suffix.lower() != '.exe', f'proprietary Windows executable bundled in release: {rel}')
+    need('target' not in rel.parts, f'release contains target artifact: {rel}')
+    need('__pycache__' not in rel.parts and path.suffix != '.pyc', f'release contains Python cache: {rel}')
+    need('.pytest_cache' not in rel.parts, f'release contains pytest cache: {rel}')
+
+for marker in (
+    'MIGRATION_PREDECESSOR=10.0.3',
+    'TARGET_VERSION=10.0.4',
+    'AETHERFORGE_OS_VERSION=10.0.3',
+    'pre-v10.0.4-',
+    'STO_LINUX_COMMAND_VERSION=10.0.4',
+    'EMBEDDED_STO=enabled',
+    'VISUAL_STABILITY=enabled',
+    'NO_DETACHED_FALLBACK=enforced',
+    'LOCAL_ARC_INSTALLER_IMPORT=enabled',
+):
+    need(marker in installer, f'10.0.4 installer marker missing: {marker}')
+need('verify-v10004-release.py' in installer and 'verify-v10003-release.py' in installer, 'current/baseline verifiers not chained')
+normalize = installer.find('cargo fmt --all\n')
+check = installer.find('cargo fmt --all --check')
+clippy = installer.find('cargo clippy --workspace --all-targets --all-features -- -D warnings')
+test = installer.find('cargo test --workspace')
+build = installer.find('cargo build --release --workspace')
+need(normalize >= 0 and normalize < check < clippy < test < build, 'host Rust qualification order changed')
+
+need('STO_LINUX_COMMAND_EXPECTED=10.0.4' in status, '10.0.4 status helper missing')
+need('GAMESCOPE=' in status and 'XDOTOOL=' in status and 'DISPLAY=' in status, 'status helper does not expose containment prerequisites')
+for marker in ('pre-v10.0.4-', 'release-state', 'ROLLBACK_RESULT=PASS'):
+    need(marker in rollback, f'10.0.4 rollback helper marker missing: {marker}')
+
+manifest_count = 0
+for manifest in ROOT.rglob('Cargo.toml'):
+    rel = manifest.relative_to(ROOT)
+    if '.worktrees' in rel.parts:
+        continue
+    manifest_count += 1
+    with manifest.open('rb') as handle:
+        data = tomllib.load(handle)
+    for section in ('dependencies', 'dev-dependencies', 'build-dependencies'):
+        for dep, spec in data.get(section, {}).items():
+            if isinstance(spec, dict) and 'path' in spec:
+                need((manifest.parent / spec['path']).resolve().exists(), f'{rel} missing local dependency {dep}')
+need(manifest_count == 10, f'expected 10 Cargo manifests, found {manifest_count}')
+
+print('PASS: 10.0.4 EMBEDDED_STO + VISUAL_STABILITY + NO_DETACHED_FALLBACK + ARC_INSTALLER_NOT_BUNDLED')
