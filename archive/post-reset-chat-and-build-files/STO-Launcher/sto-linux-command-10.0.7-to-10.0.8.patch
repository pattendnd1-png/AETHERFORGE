+' || printf 'GAMESCOPE_VISUAL_HOST=missing
+'
+command -v xdotool >/dev/null 2>&1 && printf 'XDOTOOL_ARC_CONTAINMENT=present
+' || printf 'XDOTOOL_ARC_CONTAINMENT=missing
+'
+[[ -n "${DISPLAY:-}" ]] && printf 'DISPLAY=%s
