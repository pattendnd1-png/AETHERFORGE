@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+def text(rel): return (ROOT/rel).read_text(encoding='utf-8')
+def need(ok,msg):
+    if not ok: raise SystemExit('FAIL: '+msg)
+
+cargo=text('Cargo.toml'); pkg=text('packaging/arch/PKGBUILD'); readme=text('README.md')
+main=text('crates/sto-gui/src/main.rs'); launch=text('crates/sto-launch/src/lib.rs')
+visual=text('crates/sto-launch/src/visual.rs'); activity=text('crates/sto-gui/src/activity.rs')
+downloads=text('crates/sto-gui/src/pages/downloads.rs')
+need('version = "10.0.8"' in cargo,'workspace version')
+need('pkgver=10.0.8' in pkg,'PKGBUILD version')
+need(readme.startswith('# STO Linux Command 10.0.8'),'README version')
+need('## v10.0.8: Fast Launch + GameClient Handoff Repair' in readme,'10.0.8 README section')
+need('build_sto_fast_launch_registry_plan' in launch,'Fast Launch registry plan')
+for marker in ('HKCU\\Software\\Cryptic\\Star Trek Online','AutoLaunch','REG_DWORD'):
+    need(marker in launch,f'Fast Launch marker {marker}')
+need('Enabling Cryptic Fast Launch' in main,'PLAY configures Fast Launch')
+need('build_sto_fast_launch_registry_plan' in main and 'execute_launch_plan' in main,'PLAY applies registry plan')
+need('"--keep-alive"' in visual,'Gamescope survives STO launcher handoff')
+need('--immediate-flips' not in visual.split('let mut args = vec![',1)[1].split('args.push("--"',1)[0], 'immediate flips remain disabled')
+need('WaitingForProcess' in activity and 'Waiting for game' in activity,'process wait state')
+need('waiting_for_process' in main and 'update_waiting(ActivityKind::Launch' in main,'launch uses process wait state')
+need('ActivityState::WaitingForProcess' in downloads,'downloads surface recognizes process wait')
+need('sto_host_pid: Option<u32>' in main and 'fn terminate_sto_host' in main,'Gamescope host lifecycle tracked')
+need(main.count('self.terminate_sto_host();') >= 2,'Gamescope host cleanup on end/failure')
+installer=text('scripts/install-v10008-dragon-glass.sh')
+for marker in ('TARGET_VERSION=10.0.8','MIGRATION_PREDECESSOR=10.0.7','pre-v10.0.8-',
+               'CRYPTIC_FAST_LAUNCH=registry-autolaunch','GAMESCOPE_HANDOFF_KEEPALIVE=enabled',
+               'PROCESS_WAIT_STATE=waiting-for-game','STO_HOST_CLEANUP=process-group'):
+    need(marker in installer,f'installer marker {marker}')
+need('STO_LINUX_COMMAND_EXPECTED=10.0.8' in text('scripts/status-v10008.sh'),'status version')
+need('pre-v10.0.8-' in text('scripts/rollback-v10008.sh') and 'ROLLBACK_FROM=10.0.8' in text('scripts/rollback-v10008.sh'),'rollback version')
+print('PASS: 10.0.8 FAST_LAUNCH + GAMESCOPE_KEEPALIVE + PROCESS_HANDOFF_STATE + HOST_CLEANUP')
