--- a/tests/test_v10008_fast_launch_handoff.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_v10008_fast_launch_handoff.py	2026-09-19 01:48:34.095857632 +0000
@@ -0,0 +1,56 @@
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+def read(path):
+    return (ROOT / path).read_text()
+
+
+def test_gamescope_survives_launcher_to_gameclient_handoff():
+    visual = read('crates/sto-launch/src/visual.rs')
+    assert '"--keep-alive"' in visual
+
+
+def test_sto_fast_launch_is_written_through_prefix_registry():
+    launch = read('crates/sto-launch/src/lib.rs')
+    assert 'build_sto_fast_launch_registry_plan' in launch
+    assert 'AutoLaunch' in launch
+    assert r'HKCU\Software\Cryptic\Star Trek Online' in launch
+    assert 'REG_DWORD' in launch
+
+
+def test_play_enables_fast_launch_before_starting_sto():
+    main = read('crates/sto-gui/src/main.rs')
+    assert 'Enabling Cryptic Fast Launch' in main
+    assert 'build_sto_fast_launch_registry_plan' in main
+    assert 'execute_launch_plan' in main
+
+
+def test_process_handoff_is_not_labeled_waiting_for_user():
+    activity = read('crates/sto-gui/src/activity.rs')
+    main = read('crates/sto-gui/src/main.rs')
+    downloads = read('crates/sto-gui/src/pages/downloads.rs')
+    assert 'WaitingForProcess' in activity
+    assert 'Waiting for game' in activity
+    assert 'waiting_for_process' in activity
+    assert 'Launch host started; waiting for STO Fast Launch handoff to GameClient.exe' in main
+    assert 'ActivityState::WaitingForProcess' in downloads
+
+
+def test_launcher_detection_updates_handoff_detail_instead_of_creating_fake_download():
+    main = read('crates/sto-gui/src/main.rs')
+    assert 'STO launcher active — Fast Launch/patch handoff in progress' in main
+    assert 'update_waiting' in main
+
+
+def test_version_is_10_0_8():
+    assert 'version = "10.0.8"' in read('Cargo.toml')
+    assert 'pkgver=10.0.8' in read('packaging/arch/PKGBUILD')
+    assert read('README.md').startswith('# STO Linux Command 10.0.8')
+
+def test_keep_alive_host_is_tracked_and_terminated_after_session():
+    main = read('crates/sto-gui/src/main.rs')
+    assert 'sto_host_pid: Option<u32>' in main
+    assert 'fn terminate_sto_host' in main
+    assert 'self.sto_host_pid = success.sto_host_pid' in main
+    assert 'self.terminate_sto_host();' in main
