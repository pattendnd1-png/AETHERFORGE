+pub fn build_sto_fast_launch_registry_plan(
+    config: &Config,
+    prefix: &Path,
+    runtime: &RuntimeDescriptor,
+) -> Result<LaunchPlan> {
+    refuse_root()?;
+    if runtime.kind != RuntimeKind::Umu {
+        bail!("STO Fast Launch configuration requires UMU + GE-Proton");
+    }
+    let reg = prefix.join("drive_c/windows/system32/reg.exe");
+    if !reg.is_file() {
+        bail!("Wine registry tool is missing from the managed prefix: {}", reg.display());
+    }
+    let args = vec![
+        "ADD".to_string(),
+        r"HKCU\Software\Cryptic\Star Trek Online".to_string(),
+        "/v".to_string(),
+        "AutoLaunch".to_string(),
+        "/t".to_string(),
+        "REG_DWORD".to_string(),
+        "/d".to_string(),
+        "1".to_string(),
+        "/f".to_string(),
+    ];
+    let plan = build_umu_plan(
+        config,
+        prefix,
+        &reg,
+        runtime,
+        &args,
+        "Enable Cryptic STO Fast Launch in the managed prefix".into(),
+    )?;
+    validate_launch_plan(&plan)?;
+    Ok(plan)
+}
