#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
TOOLCHAIN="$ROOT/tools/rust/x86_64-unknown-linux-gnu"
REAL_RUSTC="$TOOLCHAIN/bin/rustc"
if [[ ! -x "$REAL_RUSTC" ]]; then
  echo "AETHERAI_BUNDLED_RUSTC=UNAVAILABLE" >&2
  exit 127
fi
exec "$REAL_RUSTC" --sysroot "$TOOLCHAIN" "$@"
