#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
HOST_TRIPLE=x86_64-unknown-linux-gnu
TOOLCHAIN="$ROOT/tools/rust/$HOST_TRIPLE"
BIN="$TOOLCHAIN/bin"
CARGO="$BIN/cargo"

if [[ ! -x "$CARGO" ]]; then
  echo 'AETHERAI_BUNDLED_RUST=UNAVAILABLE' >&2
  echo "AETHERAI_EXPECTED_CARGO=$CARGO" >&2
  exit 127
fi

export PATH="$BIN:${PATH:-/usr/bin:/bin}"
export CARGO_HOME="$ROOT/.aetherai/cargo-home"
export SYSROOT="$TOOLCHAIN"
export RUSTC="$BIN/rustc"
export RUSTDOC="$BIN/rustdoc"
export RUSTFLAGS="--sysroot=$TOOLCHAIN"
export RUSTDOCFLAGS="--sysroot=$TOOLCHAIN"
export RUSTFMT="$BIN/rustfmt"
export CLIPPY_DRIVER="$BIN/clippy-driver"
export CARGO_NET_OFFLINE=true
export LD_LIBRARY_PATH="$TOOLCHAIN/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
mkdir -p "$CARGO_HOME"

exec "$CARGO" "$@"
