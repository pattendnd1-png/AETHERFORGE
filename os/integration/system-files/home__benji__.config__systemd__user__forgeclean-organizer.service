[Unit]
Description=ForgeClean persistent Downloads organizer and ColdStore manager
ConditionPathIsDirectory=%h/Downloads

[Service]
Type=simple
ExecStart=%h/.local/bin/forgeclean watch
Restart=always
RestartSec=2
Nice=10
IOSchedulingClass=idle
CPUWeight=25
IOWeight=25
TimeoutStopSec=15

[Install]
WantedBy=default.target
