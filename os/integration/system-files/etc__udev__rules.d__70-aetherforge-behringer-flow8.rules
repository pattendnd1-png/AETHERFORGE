# AetherForge Behringer Control — FLOW 8 / Behringer USB access
# Music Tribe's SimplyPUT Linux guide identifies Behringer vendor id 1397.
# uaccess keeps access scoped to the active local user instead of MODE=0666.
SUBSYSTEM=="usb", ATTR{idVendor}=="1397", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb_device", ATTRS{idVendor}=="1397", MODE="0660", TAG+="uaccess"
