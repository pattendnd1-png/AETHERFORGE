[Unit]
Description=AetherForge Static DragonGlass motion policy
After=plasma-workspace.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/lib/aetherforge/apply-static-dragonglass
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
