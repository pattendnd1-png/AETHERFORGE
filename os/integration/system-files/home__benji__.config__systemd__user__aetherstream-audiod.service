[Unit]
Description=AetherStream live output DSP service
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
Before=aetherstream-supervisord.service

[Service]
Type=simple
ExecStart=%h/.local/bin/aetherstream-audiod
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
